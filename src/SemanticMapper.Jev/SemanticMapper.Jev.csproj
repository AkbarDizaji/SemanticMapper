<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SemanticMapper.Jev</RootNamespace>
    <PackageId>SemanticMapper.Jev</PackageId>
    <Description>TypeSafe Jev semantic field matcher for SemanticMapper. Calls the TypeSafe System One API directly with your own API key.</Description>
    <PackageTags>$(PackageTags);typesafe;jev</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemanticMapper.Core\SemanticMapper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SemanticMapper.Jev.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
